# dependencies
node_modules

# env files (NEVER commit secrets)
.env
.env.local
.env.production
.env*.local

# next.js build
.next
out

# build artifacts
*.tsbuildinfo

# PWA (generated by next-pwa at build time)
public/sw.js
public/workbox-*.js
public/sw.js.map
public/workbox-*.js.map

# uploaded compliance documents (never committed — see storage/ on the VPS)
storage

# test output
coverage

# misc
.DS_Store
*.pem

# local machine settings
.claude/settings.local.json

# local debugging scripts. Build tooling under scripts/ is part of the
# project and is excepted below.
*.mjs
!next.config.mjs
!postcss.config.mjs
!scripts/*.mjs

# Scanner model, copied from node_modules at build time (see scripts/copy-scanner-model.mjs)
public/scanner/
