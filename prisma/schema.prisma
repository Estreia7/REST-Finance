generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  TRIAL
  MONTHLY
  YEARLY
}

enum MembershipRole {
  OWNER
  STAFF
  PLATFORM_ADMIN
}

enum CategoryType {
  REVENUE
  COGS
  OPEX
}

enum CostType {
  COGS
  OPEX
}

/// How a cost was, or will be, paid.
///
/// DIRECT_DEBIT is a promise rather than a payment: the money leaves on the
/// due date by itself. Until then it counts as money about to go out, never
/// as overdue, and from that day it counts as paid without anyone saying so.
enum PaymentMethod {
  CASH
  MULTIBANCO
  TRANSFER
  DIRECT_DEBIT
}

/// Documents a restaurant has to keep current. Ordered roughly by how often
/// they are asked for in an inspection.
/// How often a document has to be renewed, so the next expiry can be
/// proposed automatically when the current one is replaced.
enum RenewalPeriod {
  NONE
  MONTHLY
  ANNUAL
}

enum ComplianceDocType {
  INSURANCE // Seguro de responsabilidade civil
  HACCP // Plano HACCP
  FIRE_SAFETY // Segurança contra incêndios
  ASAE_LICENCE // Licença de utilização / ASAE
  HYGIENE_CERT // Formação em higiene alimentar
  WASTE_CONTRACT // Contrato de recolha de resíduos
  PEST_CONTROL // Controlo de pragas
  OTHER
}

model Restaurant {
  id                 String    @id @default(uuid())
  name               String
  plan               Plan      @default(TRIAL)
  trialEndsAt        DateTime? @map("trial_ends_at")
  adminAccessEnabled Boolean   @default(false) @map("admin_access_enabled")
  createdAt          DateTime  @default(now()) @map("created_at")

  // Stripe billing fields
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  subscriptionStatus   String?   @map("subscription_status") // active | trialing | past_due | canceled | unpaid
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")

  // Onboarding
  onboardingCompleted  Boolean  @default(false) @map("onboarding_completed")
  monthlyRevenueTarget Decimal? @map("monthly_revenue_target") @db.Decimal(12, 2)

  /// Restaurant logo, stored as a path under the storage directory rather
  /// than in the database. Served through an authenticated route so it is
  /// not world-readable by URL guessing.
  logoPath String? @map("logo_path")

  /// Dining room capacity and service length, used for RevPASH (revenue per
  /// available seat-hour). Null until the owner supplies them, so the metric
  /// is hidden rather than computed from a guess.
  seats              Int?     @map("seats")
  serviceHoursPerDay Decimal? @map("service_hours_per_day") @db.Decimal(4, 1)

  // Settings
  timezone String  @default("Europe/Lisbon")
  currency String  @default("EUR")
  taxId    String? @map("tax_id") // NIF for accountant reports

  /// The council the restaurant pays its derrama to, by the Tax Authority's
  /// district/council code ("0813" is Silves). See lib/derrama.ts.
  municipalityCode String? @map("municipality_code")

  memberships       Membership[]
  categories        Category[]
  dailySummaries    DailySummary[]
  costEntries       CostEntry[]
  auditLogs         AuditLog[]
  stripeEvents      StripeEvent[]
  notifications     Notification[]
  exportLogs        ExportLog[]
  receiptScans      ReceiptScan[]
  vendors           Vendor[]
  invoiceItems      InvoiceItem[]
  complianceDocs    ComplianceDoc[]
  scheduleEmployees ScheduleEmployee[]
  shiftTemplates    ShiftTemplate[]
  shifts            Shift[]
  scheduleClosures  ScheduleClosure[]
  employeeLeaves    EmployeeLeave[]
  recurringCosts    RecurringCost[]
  ingredients       Ingredient[]
  menuItems         MenuItem[]
  supportTickets    SupportTicket[]
  categoryRevenue   DailyCategoryRevenue[]
  posProducts       PosProduct[]
  posProductSales   PosProductSale[]
  invoiceItemLinks  InvoiceItemLink[]
  lineMemories      InvoiceLineMemory[]
  aiUsage           AiUsage[]
  scanCorrections   ScanCorrection[]

  @@map("restaurants")
}

model StripeEvent {
  id           String      @id
  type         String
  processed    Boolean     @default(false)
  data         Json
  restaurantId String?     @map("restaurant_id")
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("stripe_events")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  /// Argon2/bcrypt hash. Null for accounts that only ever sign in with
  /// Google, so a password is never invented for them.
  passwordHash String? @map("password_hash")

  /// Set when the address is confirmed. Auth.js reads this field by name.
  emailVerified DateTime? @map("email_verified")

  /// Profile picture from an OAuth provider. Auth.js reads this field by name.
  image String?

  notificationPrefs Json? @map("notification_prefs")

  /// The account's language, "pt" or "en". Null until the owner chooses one,
  /// which is what lets a first login fall back to the browser's preference
  /// rather than forcing Portuguese on someone who asked for English.
  language String? @map("language")

  /// Which version of the first-run walkthrough this account has finished or
  /// skipped. Null means never seen. Kept on the account rather than in the
  /// browser so it does not run again on a second device, and versioned so a
  /// later rewrite can be offered without replaying it for everyone.
  tourVersion Int? @map("tour_version")

  accounts Account[]
  sessions Session[]

  memberships           Membership[]
  createdSummaries      DailySummary[]   @relation("SummaryCreatedBy")
  createdCosts          CostEntry[]      @relation("CostCreatedBy")
  createdRecurringCosts RecurringCost[]  @relation("RecurringCostCreatedBy")
  auditLogs             AuditLog[]       @relation("AuditActor")
  notifications         Notification[]
  receiptScans          ReceiptScan[]
  complianceDocs        ComplianceDoc[]  @relation("ComplianceUploadedBy")
  supportTickets        SupportTicket[]  @relation("SupportRequester")
  supportReplies        SupportTicket[]  @relation("SupportResponder")
  extractionTests       ExtractionTest[]
  aiUsage               AiUsage[]

  @@map("users")
}

/// Auth.js: one row per external identity linked to a user (Google, etc).
/// Linking is by verified email, so signing in with Google after registering
/// with a password reaches the same account rather than creating a second one.
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Auth.js: database-backed sessions, so signing out on the server actually
/// revokes access rather than waiting for a JWT to expire.
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Platform-wide settings an administrator can change without a redeploy.
/// Values marked `encrypted` are stored as AES-256-GCM ciphertext (lib/crypto.ts)
/// so a database dump does not expose third-party credentials in plain text.
model AppSetting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("app_settings")
}

/// Auth.js: short-lived tokens for email verification and password resets.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Membership {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  role        MembershipRole @default(STAFF)
  active      Boolean        @default(true)
  permissions String[]       @default(["view"])
  createdAt   DateTime       @default(now()) @map("created_at")

  @@unique([restaurantId, userId])
  @@map("memberships")
}

model Category {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  type      CategoryType
  name      String
  sortOrder Int          @default(0) @map("sort_order")
  isActive  Boolean      @default(true) @map("is_active")

  /// Marks a cost category as labour (wages, employer contributions) so Prime
  /// Cost can be computed reliably. Previously labour was matched by hardcoded
  /// category names, which silently produced labour = 0 — and a Prime Cost
  /// understated by roughly half — for any restaurant using its own names.
  isLabour Boolean @default(false) @map("is_labour")

  /// Marks a cost category as occupancy (rent, property tax, building
  /// insurance). USAR puts occupancy below controllable income, because a
  /// manager cannot renegotiate the lease this month: leaving rent among the
  /// controllable costs makes a good operator in an expensive location look
  /// like a bad one.
  isOccupancy Boolean @default(false) @map("is_occupancy")

  recurringCosts RecurringCost[]
  costEntries    CostEntry[]
  dailyRevenue   DailyCategoryRevenue[]
  posProducts    PosProduct[]
  invoiceItems   InvoiceItem[]
  lineMemories   InvoiceLineMemory[]

  @@index([restaurantId, isActive])
  @@map("categories")
}

model DailySummary {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  date            DateTime
  dineInRevenue   Decimal  @default(0) @map("dine_in_revenue") @db.Decimal(12, 2)
  takeawayRevenue Decimal  @default(0) @map("takeaway_revenue") @db.Decimal(12, 2)
  revenueTotal    Decimal  @default(0) @map("revenue_total") @db.Decimal(12, 2)
  dineInTickets   Int      @default(0) @map("dine_in_tickets")
  takeawayTickets Int      @default(0) @map("takeaway_tickets")
  notes           String?

  createdBy   User   @relation("SummaryCreatedBy", fields: [createdById], references: [id])
  createdById String @map("created_by")

  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([restaurantId, date])
  @@map("daily_summaries")
}

model CostEntry {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  date DateTime
  type CostType

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?   @map("category_id")

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String? @map("vendor_id")

  amount      Decimal @db.Decimal(12, 2)
  description String?

  createdBy   User      @relation("CostCreatedBy", fields: [createdById], references: [id])
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  /// Set on entries booked automatically from a fixed monthly cost.
  recurringCost   RecurringCost? @relation(fields: [recurringCostId], references: [id])
  recurringCostId String?        @map("recurring_cost_id")

  /// The supplier's document number, when there is one. Typed with the cost,
  /// read off a scan, or added later when the paper turns up. A cost with
  /// none is one still waiting for its invoice.
  invoiceNumber String? @map("invoice_number")

  /// Payment, on the original entry only: an invoice split by category is
  /// still one document and is paid once. Parts leave these empty.
  ///
  /// Null paidAt is unpaid, unless the method is a direct debit, which pays
  /// itself on the due date. dueDate is the owner's own date; when null it
  /// is the cost's date plus the supplier's terms, so changing a supplier's
  /// terms moves every invoice still open with them.
  paymentMethod PaymentMethod? @map("payment_method")
  paidAt        DateTime?      @map("paid_at") @db.Date
  dueDate       DateTime?      @map("due_date") @db.Date

  invoiceItems InvoiceItem[]
  receiptScans ReceiptScan[]

  /// The entry this one was split from, when one invoice held lines of
  /// several categories. A Makro invoice with meat, beer and bleach is one
  /// document but three costs: booked whole under "Comida", the bleach
  /// inflated food cost and the beer hid inside it. Each part carries its
  /// share of the total; the original keeps the largest. Null on the
  /// original and on every entry that was never split.
  splitFrom   CostEntry?  @relation("CostEntrySplit", fields: [splitFromId], references: [id])
  splitFromId String?     @map("split_from_id")
  splitParts  CostEntry[] @relation("CostEntrySplit")

  /// One booking per fixed cost per day: two dashboards opening at once
  /// must not book the same month twice.
  @@unique([recurringCostId, date])
  @@index([restaurantId, date])
  @@index([restaurantId, type, date])
  @@index([splitFromId])
  @@index([restaurantId, paidAt])
  @@map("cost_entries")
}

/// A cost that repeats every month — rent, internet, a 12-month contract.
///
/// Typed once; the app books a CostEntry on dayOfMonth each month from
/// startDate until endDate. Entries are booked when the dashboard opens
/// (there is no scheduler on the box), catching up any months missed, and
/// lastGeneratedDate records how far that has got so nothing is booked
/// twice. Changing the amount changes only the months still to come; the
/// ones already booked are real costs and stay as they were.
model RecurringCost {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  type        CostType
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?   @map("category_id")
  amount      Decimal   @db.Decimal(12, 2)
  description String?

  /// 1–31; a 31 falls on the last day of shorter months.
  dayOfMonth        Int       @map("day_of_month")
  /// The first booking.
  startDate         DateTime  @map("start_date") @db.Date
  /// The last booking, inclusive. Null runs until stopped.
  endDate           DateTime? @map("end_date") @db.Date
  lastGeneratedDate DateTime? @map("last_generated_date") @db.Date
  active            Boolean   @default(true)

  /// How each month is paid. Null books every month as still to pay; any
  /// other books it paid that way on its own date (a direct debit, on the
  /// day it leaves the account).
  paymentMethod PaymentMethod? @map("payment_method")
  /// Who it is paid to, so every month sits with that supplier and falls due
  /// on that supplier's terms.
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  vendorId      String?        @map("vendor_id")

  createdBy   User     @relation("RecurringCostCreatedBy", fields: [createdById], references: [id])
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entries CostEntry[]

  @@index([restaurantId, active])
  @@map("recurring_costs")
}

model AuditLog {
  id           String      @id @default(uuid())
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  restaurantId String?     @map("restaurant_id")

  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id])
  actorUserId String? @map("actor_user_id")

  action    String
  metadata  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

enum NotificationType {
  ANNOUNCEMENT
  ALERT
  SYSTEM
}

enum ScanType {
  COST_RECEIPT
  DAILY_REPORT
}

enum ScanStatus {
  PENDING
  PROCESSED
  FAILED
}

model Notification {
  id           String           @id @default(uuid())
  restaurant   Restaurant?      @relation(fields: [restaurantId], references: [id])
  restaurantId String?          @map("restaurant_id")
  user         User             @relation(fields: [userId], references: [id])
  userId       String           @map("user_id")
  title        String
  message      String
  type         NotificationType @default(SYSTEM)
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}

model ExportLog {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")
  userId       String     @map("user_id")
  type         String
  resource     String
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("export_logs")
}

model ReceiptScan {
  id            String     @id @default(uuid())
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId  String     @map("restaurant_id")
  user          User       @relation(fields: [userId], references: [id])
  userId        String     @map("user_id")
  imageUrl      String     @map("image_url")
  scanType      ScanType   @map("scan_type")
  extractedData Json?      @map("extracted_data")
  status        ScanStatus @default(PENDING)

  linkedEntry   CostEntry? @relation(fields: [linkedEntryId], references: [id])
  linkedEntryId String?    @map("linked_entry_id")
  createdAt     DateTime   @default(now()) @map("created_at")

  /// When the owner finished saying what the lines are. Null for a reading
  /// that was never confirmed, which is itself worth knowing.
  reviewedAt DateTime? @map("reviewed_at")

  invoiceItems InvoiceItem[]
  corrections  ScanCorrection[]

  @@map("receipt_scans")
}

/// One thing the reader got wrong on an invoice, and what it became.
///
/// Written when the owner confirms an invoice, by comparing what the reader
/// returned with what was saved. A line whose category the restaurant's
/// memory corrected counts as much as one the owner corrected: both are the
/// reader being wrong, and both are what the next prompt change is measured
/// against. Nothing here is consulted while reading — the memory already
/// holds the right answers — it is the record of how often they were needed.
model ScanCorrection {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  /// Kept if the scan is removed, set to null: the mistake still happened.
  receiptScan   ReceiptScan? @relation(fields: [receiptScanId], references: [id], onDelete: SetNull)
  receiptScanId String?      @map("receipt_scan_id")
  vendor        Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId      String?      @map("vendor_id")

  /// The line's wording as printed, or null for a field of the invoice
  /// itself (supplier, date, total).
  productName String? @map("product_name")

  /// What was wrong: vendor, date, total, type, category, pack, unitPrice.
  /// Free text, so a new check does not need a migration.
  field      String
  readValue  String? @map("read_value")
  savedValue String? @map("saved_value")
  /// Who put it right: owner, memory (the restaurant already knew), or
  /// check (the arithmetic of the line).
  fixedBy    String  @map("fixed_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([restaurantId, createdAt])
  @@map("scan_corrections")
}

/// Insurance policies, licences and certificates, with their expiry dates.
///
/// The file itself lives under the storage directory and only its path is
/// kept here, so a database dump does not carry the documents. Soft deleted,
/// because an expired policy is still the record of what was in force at the
/// time and may be needed after an incident.
model ComplianceDoc {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  type      ComplianceDocType
  name      String
  /// Policy or licence number, as printed on the document.
  reference String?

  filePath  String @map("file_path")
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")

  /// Monthly or annual renewal. NONE for one-off documents.
  renewalPeriod RenewalPeriod @default(NONE) @map("renewal_period")

  issuedAt  DateTime? @map("issued_at")
  /// Null for documents that do not expire, so they are never chased.
  expiresAt DateTime? @map("expires_at")

  notes String?

  uploadedBy   User      @relation("ComplianceUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String    @map("uploaded_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  /// Drives the expiry queries that power the dashboard warnings.
  @@index([restaurantId, expiresAt])
  @@index([restaurantId, type])
  @@map("compliance_docs")
}

model Vendor {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  name     String
  taxId    String? @map("tax_id") // NIF
  isActive Boolean @default(true) @map("is_active")

  /// Days this supplier gives to pay. Null is the legal default of 30.
  paymentTermsDays Int? @map("payment_terms_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  costEntries    CostEntry[]
  recurringCosts RecurringCost[]
  invoiceItems   InvoiceItem[]
  itemLinks      InvoiceItemLink[]
  lineMemories   InvoiceLineMemory[]
  corrections    ScanCorrection[]

  @@unique([restaurantId, name])
  @@map("vendors")
}

model InvoiceItem {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  costEntry   CostEntry? @relation(fields: [costEntryId], references: [id])
  costEntryId String?    @map("cost_entry_id")

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String? @map("vendor_id")

  receiptScan   ReceiptScan? @relation(fields: [receiptScanId], references: [id])
  receiptScanId String?      @map("receipt_scan_id")

  productName    String  @map("product_name")
  normalizedName String  @map("normalized_name")
  quantity       Decimal @db.Decimal(10, 3)
  unit           String? // kg, L, un, etc.
  unitPrice      Decimal @map("unit_price") @db.Decimal(10, 4)
  totalPrice     Decimal @map("total_price") @db.Decimal(12, 2)

  invoiceDate   DateTime? @map("invoice_date")
  invoiceNumber String?   @map("invoice_number")

  /// What kind of cost this line is. Per line, not per invoice: one
  /// delivery can hold food, drink and cleaning, and the P&L needs them
  /// apart. The cost entry this line sits under has the same category.
  category       Category?           @relation(fields: [categoryId], references: [id])
  categoryId     String?             @map("category_id")
  categorySource LineCategorySource? @map("category_source")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([restaurantId, normalizedName, vendorId, invoiceDate])
  @@index([restaurantId, invoiceDate])
  @@map("invoice_items")
}

/// Where a line's category came from.
///
/// Kept so the app can tell how much it is deciding by itself: the share of
/// MEMORY lines is how close a restaurant is to invoices that need no one.
enum LineCategorySource {
  /// The owner chose it, or changed what was suggested.
  OWNER
  /// The restaurant's memory already knew this wording.
  MEMORY
  /// Suggested — by a similar wording, the supplier's habit or the reader —
  /// and accepted as it was.
  SUGGESTED
  /// Saved before lines had categories, and copied from the invoice's. Never
  /// learned from: a mixed invoice booked whole under one category would
  /// teach the wrong answer for every line but one.
  INHERITED
}

/// A person on the roster.
///
/// Deliberately not a User. The people who appear on a restaurant's schedule
/// are not the people who log into its accounting: the kitchen porter and the
/// weekend server need to be on the rota and will never open the app. Forcing
/// an email and an invite on them would make the schedule unusable for the
/// half of the team it exists to organise.
model ScheduleEmployee {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  name String
  /// Free text rather than an enum: every restaurant names its own stations.
  role String?

  /// Identifies the person at a glance on a dense grid, and survives being
  /// printed or sent as an image where hover is not available.
  color String @default("slate")

  /// Ordering on the grid, so the owner can group the kitchen together.
  sortOrder Int @default(0) @map("sort_order")

  /// The day the contract started. Decides the holiday entitlement: in the
  /// year someone joins they earn 2 working days per complete month, not 22.
  /// Optional, because people already on the rota were added without it;
  /// until it is filled in they are treated as having a full year.
  startDate DateTime? @map("start_date") @db.Date

  /// Someone who has left keeps their past shifts: a schedule that rewrites
  /// history when a person leaves is not a record of anything. They simply
  /// stop appearing on new weeks.
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  shifts Shift[]
  leaves EmployeeLeave[]

  @@index([restaurantId, active, sortOrder])
  @@map("schedule_employees")
}

/// A stretch of holiday booked for one person.
///
/// Stored as the two calendar dates, inclusive, and never as a count: how
/// many working days it uses depends on weekends and public holidays, which
/// are worked out when it is read. Storing a count would freeze today's
/// holiday calendar into the row and go wrong the year a holiday moves.
model EmployeeLeave {
  id           String           @id @default(uuid())
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id])
  restaurantId String           @map("restaurant_id")
  employee     ScheduleEmployee @relation(fields: [employeeId], references: [id])
  employeeId   String           @map("employee_id")

  /// First day off, midnight UTC, as a date.
  startDate DateTime @map("start_date") @db.Date
  /// Last day off, inclusive.
  endDate   DateTime @map("end_date") @db.Date
  note      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Read as "this restaurant, this stretch of the calendar".
  @@index([restaurantId, startDate])
  @@index([employeeId, startDate])
  @@map("employee_leaves")
}

/// A named shift the restaurant uses often, such as "Manhã 09:00–17:00".
///
/// The owner still types free hours for the days that break the pattern; the
/// template is a shortcut, not a constraint.
model ShiftTemplate {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  label    String
  /// Minutes from midnight. Integers compare and sum without timezone or
  /// DST trouble, which a DateTime on a recurring weekly grid invites.
  startMin Int    @map("start_min")
  endMin   Int    @map("end_min")

  /// A saved split shift carries its break, so "Partido" reusable means the
  /// same thing every time it is applied.
  breakStartMin Int? @map("break_start_min")
  breakEndMin   Int? @map("break_end_min")

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([restaurantId, sortOrder])
  @@map("shift_templates")
}

/// One person working one day.
///
/// Keyed by calendar date rather than by week plus weekday: copying a week
/// forward then becomes ordinary row creation, and a shift always knows the
/// real day it belongs to without the caller reconstructing it.
model Shift {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  employee   ScheduleEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String           @map("employee_id")

  /// Midnight UTC on the day worked. Stored as a date, not an instant.
  date DateTime @db.Date

  startMin Int @map("start_min")
  endMin   Int @map("end_min")

  /// The unpaid gap in a split shift: in at 12:00, off from 15:00 to 19:00,
  /// out at 23:00. Restaurants run lunch and dinner as one turno with the
  /// afternoon off, so the day is one shift with a hole, not two shifts.
  /// Both are set together or neither is; the hours worked deduct the gap.
  breakStartMin Int? @map("break_start_min")
  breakEndMin   Int? @map("break_end_min")

  /// "Fecho", "Só até às 15h" — whatever the owner needs the team to read.
  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One shift per person per day. A split shift is one row with a break in
  /// the middle rather than two rows, which keeps the grid one cell per cell
  /// and the weekly total a single sum.
  @@unique([employeeId, date])
  @@index([restaurantId, date])
  @@map("shifts")
}

/// A day the restaurant does not open.
///
/// Its own table rather than a flag on Shift: a closed day is a fact about
/// the restaurant, not about any one person, and it has to survive every
/// employee being removed from that day.
model ScheduleClosure {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  date   DateTime @db.Date
  /// "Feriado", "Férias", "Obras" — shown on the image sent to the team.
  reason String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([restaurantId, date])
  @@index([restaurantId, date])
  @@map("schedule_closures")
}

/// An ingredient the kitchen buys, priced per unit.
///
/// Separate from InvoiceItem because the two answer different questions.
/// InvoiceItem is a historical record — what was bought, on which invoice, at
/// what price. This is the current working cost of a thing the kitchen uses,
/// which a recipe multiplies by a quantity. Linking the two by normalised
/// name is what lets a supplier's price rise show up in a dish's margin
/// without the owner re-typing anything.
model Ingredient {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  name String

  /// Another ingredient this is really a portion of.
  ///
  /// The POS import brings in its modifiers as ingredients, so a kitchen
  /// ends up with both "Carne Smash" and "EXTRA CARNE" — the same meat,
  /// bought once, served two ways. Two separate ingredients would mean two
  /// costs for one product, free to drift apart, and an invoice would have
  /// to be told twice which it priced.
  ///
  /// So one points at the other. The alias keeps its own name, because that
  /// is what the till prints and what the ingredients ranking counts, but
  /// its cost is whatever the real ingredient costs.
  aliasOf        Ingredient?  @relation("IngredientAlias", fields: [aliasOfId], references: [id], onDelete: SetNull)
  aliasOfId      String?      @map("alias_of_id")
  aliases        Ingredient[] @relation("IngredientAlias")
  /// Matches against InvoiceItem.normalizedName, so invoices can price this.
  normalizedName String       @map("normalized_name")

  /// The unit the kitchen measures in: kg, L, un. Recipes state quantities in
  /// a sub-unit (g, ml) and convert, because nobody writes "0.15 kg of cod".
  unit String @default("kg")

  /// Cost per unit, in euros, excluding VAT.
  ///
  /// Null means "take it from the invoices": the cost is then whatever the
  /// most recent invoice said, and it moves on its own. A number here pins it,
  /// for things that never appear on an invoice — oil by the drop, the gas
  /// that cooks it, a garnish bought at the market for cash.
  manualUnitCost Decimal? @map("manual_unit_cost") @db.Decimal(10, 4)

  /// Cached from the latest matching invoice, so a menu of forty dishes does
  /// not issue forty lookups. Refreshed when the menu is opened.
  invoiceUnitCost Decimal?  @map("invoice_unit_cost") @db.Decimal(10, 4)
  invoiceCostAt   DateTime? @map("invoice_cost_at")

  /// Waste and trim: 1kg of whole fish does not yield 1kg of plated fish.
  /// A percentage rather than a factor, because that is how a chef says it.
  wastePercent Decimal @default(0) @map("waste_percent") @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  recipeLines RecipeLine[]
  itemLinks   InvoiceItemLink[]

  /// The menu items sold as this exact purchase — see MenuItem.purchaseItem.
  /// Empty for a real ingredient: lettuce goes into several dishes and is
  /// the selling of none of them.
  soldAs MenuItem[] @relation("PurchaseSource")

  @@index([restaurantId, deletedAt])
  @@index([restaurantId, normalizedName])
  @@map("ingredients")
}

/// How an item on the menu gets its cost.
///
/// Two honest answers, and the owner drew the line himself: a Super Bock is
/// not an ingredient, it is a product. Lettuce, bacon and burger buns go
/// *into* something; a bottle of beer is poured from no recipe.
enum CostingMode {
  /// Costed from its recipe lines — what the kitchen makes.
  RECIPE
  /// Costed from one purchase — sold exactly as it was bought.
  PURCHASE
}

/// A dish, drink, or set menu that appears on the menu board.
model MenuItem {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  name     String
  category String?

  /// What the customer pays, VAT included — the number printed on the menu.
  ///
  /// Storing the gross price is the point: it is the only figure the owner
  /// can check against the board without doing arithmetic. The net price is
  /// derived when margins are computed, never stored, so it cannot drift out
  /// of step with the VAT rate.
  priceGross Decimal @map("price_gross") @db.Decimal(10, 2)

  /// Portugal charges 13% on restaurant food and 23% on alcohol, so the rate
  /// belongs to the item, not the restaurant. Stored as a percentage.
  vatRate Decimal @default(13) @map("vat_rate") @db.Decimal(5, 2)

  /// Roughly how many are sold in a month. Optional, and only used to rank
  /// dishes by what they actually contribute: a 70% margin on something
  /// nobody orders matters less than 55% on the dish that carries the room.
  monthlyVolume Int? @map("monthly_volume")

  active    Boolean   @default(true)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  /// Whether this is costed from a recipe or from a single purchase.
  ///
  /// Defaults to RECIPE, which is every item that existed before this was
  /// added: a dish with no lines yet reads as work still to do, which is
  /// what it was already doing.
  costingMode CostingMode @default(RECIPE) @map("costing_mode")

  /// In PURCHASE mode, the bought thing this item is the selling of.
  ///
  /// A Super Bock is two numbers — EUR 1,73 on the board and what the
  /// wholesaler charged for the bottle — so it is two rows. The cost stays on
  /// the Ingredient because everything that prices anything is keyed there:
  /// the invoice match on normalizedName, the price history, the reconcile
  /// dialog, and InvoiceItemLink's foreign key. Putting a second cost on this
  /// table would mean a second copy of all of it.
  ///
  /// SetNull, not Cascade: taking a drink off the board must not delete the
  /// purchase line, because the owner's answer to "what is this invoice line"
  /// hangs off it and has to outlive a menu change.
  purchaseItem   Ingredient? @relation("PurchaseSource", fields: [purchaseItemId], references: [id], onDelete: SetNull)
  purchaseItemId String?     @map("purchase_item_id")

  /// Set when we worked this row out ourselves and are not certain.
  ///
  /// Guessing is unavoidable here -- no word list knows that "BRITANGO
  /// GARRAFA" is a wine, and no price separates a lemonade the kitchen makes
  /// from a beer it opens. So where the evidence agrees the row is taken as
  /// settled, and where it does not the owner is asked once, in a list he can
  /// work through in a minute. Cleared the moment he confirms or corrects it.
  ///
  /// Getting this wrong is not cosmetic: 13% on a wine is an understated tax
  /// bill, and a milkshake with no recipe is a margin that looks fine and
  /// is not.
  needsReview Boolean @default(false) @map("needs_review")

  recipeLines RecipeLine[]

  @@index([restaurantId, deletedAt, sortOrder])
  @@map("menu_items")
}

/// One ingredient in one dish, with how much of it the recipe uses.
model RecipeLine {
  id String @id @default(uuid())

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId String   @map("menu_item_id")

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientId String     @map("ingredient_id")

  /// In the recipe's own unit — grams, millilitres, or whole units — which is
  /// how a chef writes it. Converted against the ingredient's purchase unit
  /// when the cost is computed.
  quantity Decimal @db.Decimal(10, 3)
  unit     String  @default("g")

  sortOrder Int @default(0) @map("sort_order")

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@map("recipe_lines")
}

/// Where a support request stands.
///
/// Deliberately short. Three states are what an owner can understand from the
/// outside — we have not looked yet, we are on it, it is done — and anything
/// finer is internal triage that would only confuse the person waiting.
enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum SupportCategory {
  QUESTION
  PROBLEM
  SUGGESTION
  BILLING
  /// Raised by the app itself when something failed for an owner, rather than
  /// written by them. Kept apart so the queue can tell a fault from a question,
  /// and so a burst of them cannot bury real requests.
  SYSTEM
}

/// A request for help, raised by an owner and answered by an administrator.
///
/// The restaurant is recorded alongside the user because the same person can
/// own several: knowing which one they were looking at is usually half the
/// answer, and asking them afterwards wastes a round trip.
model SupportTicket {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")
  user         User       @relation("SupportRequester", fields: [userId], references: [id])
  userId       String     @map("user_id")

  subject  String
  message  String
  category SupportCategory @default(QUESTION)
  status   SupportStatus   @default(OPEN)

  /// The administrator's answer, shown to the owner once written.
  reply       String?
  repliedAt   DateTime? @map("replied_at")
  repliedBy   User?     @relation("SupportResponder", fields: [repliedById], references: [id])
  repliedById String?   @map("replied_by_id")

  /// What actually broke, for a SYSTEM ticket: the real error and where it
  /// came from. Never shown to the owner — Prisma errors name tables and
  /// columns, and an SDK error can describe how a request was handled — but
  /// it is the whole reason the ticket is worth having.
  technical String? @map("technical")

  /// How many times this same fault has happened. One owner hitting a broken
  /// screen ten times is one problem, not ten tickets, and a count says more
  /// about severity than ten identical rows would.
  occurrences Int @default(1)

  /// The most recent time this fault occurred, which for a repeated one is
  /// more useful than when it was first seen.
  lastSeenAt DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Newest first is the only order either side reads these in.
  @@index([restaurantId, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

/// A single run of the extraction bench, kept so accuracy can be measured
/// rather than guessed at.
///
/// Separate from `ReceiptScan`, which belongs to a restaurant and can be
/// linked to a real cost entry. These are laboratory runs: they carry the
/// model, the prompt version, what the model said, what was actually on the
/// paper, and what it cost — none of which belongs in a client's records.
///
/// The image is stored as a path, not bytes: a test corpus of invoices is
/// large, and a database dump should not carry photographs of real suppliers.
model ExtractionTest {
  id     String @id @default(uuid())
  /// The administrator who ran it.
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  scanType  ScanType @map("scan_type")
  /// Where the uploaded image lives under the storage directory.
  imagePath String   @map("image_path")
  /// Original filename, so a run can be recognised in the list.
  imageName String   @map("image_name")

  /// Which model answered, and under which prompt, so a change in either can
  /// be attributed. Free text rather than an enum: models are added faster
  /// than migrations are run.
  model         String
  promptVersion String @map("prompt_version")

  /// Exactly what the model returned, before any correction.
  extracted   Json?
  /// What was actually on the document, typed in by the administrator.
  /// Null until someone has checked the run.
  truth       Json?
  /// Per-field verdicts, written when truth is supplied.
  fieldScores Json?  @map("field_scores")
  /// Share of checked fields that matched, 0..1. Null until checked.
  accuracy    Float?

  /// What it cost to ask, so accuracy can be weighed against price.
  inputTokens  Int? @map("input_tokens")
  outputTokens Int? @map("output_tokens")
  /// Wall-clock time of the API call.
  durationMs   Int? @map("duration_ms")

  status ScanStatus @default(PENDING)
  /// Why it failed, when it did.
  error  String?

  /// Free-text observations: "blurred", "faded till roll", "two pages".
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Newest first, and filtered by type, are the only orders this is read in.
  @@index([createdAt])
  @@index([scanType, createdAt])
  @@map("extraction_tests")
}

/// One call to an AI model, and what it cost.
///
/// Written for every call, the owner's scans and the administrator's bench
/// alike, successful or not: a declined or failed request is still billed,
/// and a log that only counted the good ones would hide exactly the documents
/// that cost money for nothing.
///
/// The cost is stored as it was at the time, not recomputed from today's price
/// list, because prices change — the move from Haiku 4.5 to 5.5 cut them by a
/// factor of ten, and last month's bill did not change with it.
///
/// Kept when the restaurant or the user is deleted (both set to null), since
/// the money was spent either way.
model AiUsage {
  id String @id @default(uuid())

  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  /// Null for the administrator's bench, which belongs to no restaurant.
  restaurantId String?     @map("restaurant_id")
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?     @map("user_id")

  /// Where the call came from: "scan" (an owner's document) or "bench" (the
  /// extraction lab). Free text, so a new feature does not need a migration.
  source   String
  scanType ScanType? @map("scan_type")

  /// The model id as sent, e.g. "claude-haiku-5-5".
  model         String
  promptVersion String? @map("prompt_version")

  /// What was read, in a few fields — supplier, document number, date,
  /// total, line count — so the console can say which document a call was.
  /// Null for a call that read nothing, and for calls logged before this.
  subject Json?

  inputTokens  Int     @default(0) @map("input_tokens")
  outputTokens Int     @default(0) @map("output_tokens")
  costUsd      Decimal @default(0) @map("cost_usd") @db.Decimal(12, 6)
  durationMs   Int?    @map("duration_ms")

  succeeded  Boolean
  /// The model's stop reason when it gave one: "refusal", "max_tokens"…
  stopReason String? @map("stop_reason")
  error      String?

  createdAt DateTime @default(now()) @map("created_at")

  /// Read by period, and by restaurant within a period.
  @@index([createdAt])
  @@index([restaurantId, createdAt])
  @@map("ai_usage")
}

/// A day's revenue in one menu category, as the till grouped it.
///
/// `DailySummary` answers "what did we take today" and splits it by channel.
/// This answers "where did it come from" — how much was comida, how much was
/// bebida — which is the question an owner asks when a good month and a bad
/// month have the same total.
///
/// Separate from `DailySummary` rather than columns on it, because the
/// categories differ per restaurant: one groups by BEBIDAS/COMIDAS/MENUS,
/// another by lunch/dinner/events. A column per category would mean a
/// migration every time a restaurant renamed a section of its menu.
///
/// The figures are VAT-inclusive, matching `DailySummary.revenueTotal` and
/// everything else the owner sees, so a day's categories sum to that day's
/// takings.
model DailyCategoryRevenue {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  date       DateTime
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String   @map("category_id")

  /// Takings in this category, VAT included.
  revenue Decimal @default(0) @db.Decimal(12, 2)

  /// The same takings net of VAT, as the till reports them.
  ///
  /// Kept because the difference is the VAT actually charged, per category —
  /// which is the only honest way to know the blended rate a restaurant is
  /// really paying. Portuguese restaurants run 13% on food and 23% on drink,
  /// so a single assumed rate is wrong for every one of them. Null where the
  /// source did not carry a net figure.
  revenueNet Decimal? @map("revenue_net") @db.Decimal(12, 2)
  /// How many items went out. Useful for spotting a category that sells a
  /// lot of units for very little money.
  quantity   Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One row per category per day, so an import corrects rather than doubles.
  @@unique([restaurantId, date, categoryId])
  /// Read as "this month, by category" and "this category, over time".
  @@index([restaurantId, date])
  @@index([categoryId, date])
  @@map("daily_category_revenue")
}

/// A product the till sells, as the POS names it.
///
/// Kept apart from `MenuItem`, which is the owner's own costed recipe: this
/// is whatever the POS happens to have, including things that are not really
/// products at all — INGREDIENTES and MOLHOS are modifiers the kitchen
/// display needs, sold at zero. Conflating the two would put "CEBOLA
/// CARAMELIZADA" in the menu calculator.
///
/// Identified by the till's own code, which survives a rename: a product
/// renamed in the POS is still the same product, and matching on name would
/// split its history in two.
model PosProduct {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  /// The till's code for this item. Unique per restaurant.
  code String
  /// What the till calls it, as last seen. Updated when the POS renames it.
  name String

  /// The family it belongs to, so a product rolls up the same way its
  /// revenue does. Null if the category has since been deleted.
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?   @map("category_id")

  /// The sub-family as the till writes it, e.g. "SMASHIES". Kept as text
  /// because sub-families change with the menu and are not worth a table.
  subFamily String? @map("sub_family")

  sales PosProductSale[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([restaurantId, code])
  @@index([restaurantId, categoryId])
  @@map("pos_products")
}

/// What one product sold on one day.
///
/// The grain the POS export actually has. `DailyCategoryRevenue` is this
/// rolled up to the family, kept separately because almost every screen
/// wants the family and reading nine thousand rows to draw one chart would
/// be wasteful.
model PosProductSale {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  product   PosProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String     @map("product_id")

  date DateTime

  /// How many went out. The figure that matters for a modifier, which sells
  /// in quantity at no price.
  quantity   Int      @default(0)
  /// Takings, VAT included.
  revenue    Decimal  @default(0) @db.Decimal(12, 2)
  /// The same net of VAT, where the export carried it.
  revenueNet Decimal? @map("revenue_net") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One row per product per day, so a re-import corrects rather than doubles.
  @@unique([restaurantId, date, productId])
  /// Read as "this product over time" and "this month, every product".
  @@index([productId, date])
  @@index([restaurantId, date])
  @@map("pos_product_sales")
}

/// A supplier's wording for something the kitchen already has a name for.
///
/// "CARNE PICADA NOVILHO 80/20" is the same thing as "Carne Smash", and no
/// amount of string comparison will ever be sure of that — only the owner
/// knows. So they are asked once, and the answer is kept here against the
/// supplier's exact wording, which is stable: next month's invoice prints the
/// same line and nothing needs asking.
///
/// Scoped to the restaurant rather than shared across the platform. Two
/// restaurants can buy the same product and mean different things by it, and
/// one owner's correction must never reprice another's menu.
model InvoiceItemLink {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  /// The supplier's wording, lower-cased and trimmed. What arrives on the
  /// invoice, not what the kitchen calls it.
  sourceName String @map("source_name")

  /// Which supplier printed it. Null matches any: a product bought from two
  /// wholesalers under the same name is still the same product, and asking
  /// twice would be asking twice for nothing.
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId String? @map("vendor_id")

  /// What it actually is. Deleting the ingredient takes the link with it,
  /// since a link to nothing would silently stop matching.
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId String     @map("ingredient_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One row per wording per supplier per ingredient — not one answer.
  /// A case of meat can feed both the burger mince and the extra portion
  /// sold on the side: same product, same price per kilo, two places it
  /// is used. Forcing a single choice would make the owner pick which of
  /// their own ingredients to leave uncosted.
  @@unique([restaurantId, sourceName, vendorId, ingredientId])
  @@index([restaurantId, sourceName])
  @@map("invoice_item_links")
}

/// What one restaurant knows about one supplier's wording.
///
/// The memory that makes invoices stop asking. Every line the owner saves
/// teaches it — the category the line belongs to, and whether it is a kitchen
/// ingredient at all — and the next invoice carrying that wording is filled in
/// from here before anything else is consulted.
///
/// Per restaurant, never shared: one owner books coffee beans as food and
/// another as a bar cost, and both are right about their own business.
model InvoiceLineMemory {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String     @map("restaurant_id")

  /// The supplier's wording, lower-cased and trimmed — the same key as
  /// InvoiceItemLink.
  sourceName String @map("source_name")

  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId String? @map("vendor_id")

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?   @map("category_id")

  /// The owner said this line is not one of the kitchen's ingredients: the
  /// deposit on a crate, a delivery fee, a bottle of bleach.
  notIngredient Boolean @default(false) @map("not_ingredient")

  /// What one package of this wording holds, as the owner answered it:
  /// "BATATA DOCE 2,5K" is 2,5 kg, so the next invoice is priced per kilo
  /// without asking. `packUnit` "un" means the owner wants it counted in
  /// packages; null means never answered.
  packAmount Decimal? @map("pack_amount") @db.Decimal(10, 3)
  packUnit   String?  @map("pack_unit")

  /// How many times this answer was given or accepted. Reset to one when
  /// the owner changes it: a corrected answer starts again from scratch.
  confirmations Int      @default(1)
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([restaurantId, sourceName, vendorId])
  @@index([restaurantId, vendorId])
  @@map("invoice_line_memories")
}
