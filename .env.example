# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Database -----------------------------------------------------------
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://user:password@host:5432/rest_finance"
# Direct connection, used by prisma migrate.
DIRECT_URL="postgresql://user:password@host:5432/rest_finance"

# --- Auth ---
# Secret for signing session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="generate-me"

# Google sign-in. Create an OAuth client at console.cloud.google.com and add
# <NEXT_PUBLIC_APP_URL>/api/auth/callback/google as an authorised redirect URI.
# Leave empty to offer email and password only.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App ----------------------------------------------------------------
# Public origin. Used for metadata, OAuth callbacks and Stripe return URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe (optional; billing is dormant during the free beta) ----------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=""
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=""

# --- Invoice scanning (optional) ----------------------------------------
# When unset, scanning falls back to a mock in development and is disabled
# in production.
DOCUMENT_SCANNER_API_URL=""
DOCUMENT_SCANNER_API_KEY=""
